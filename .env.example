# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase.
# URL base do projeto (SEM o sufixo /rest/v1/)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica (anon) — usada pelo client em src/integrations/supabase/client.ts
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon
VITE_SUPABASE_ANON_KEY=sua-chave-anon
